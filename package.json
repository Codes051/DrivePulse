{
  "name": "drivepulse",
  "version": "1.0.0",
  "private": true,
  "description": "Connected vehicle telemetry and predictive maintenance platform",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@drivepulse/api",
    "dev:web": "npm run dev --workspace=@drivepulse/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}