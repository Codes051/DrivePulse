generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleStatus {
  ONLINE
  OFFLINE
  WARNING
  MAINTENANCE
}

model Vehicle {
  id           String        @id @default(uuid())
  vehicleCode  String        @unique
  manufacturer String
  model        String
  year         Int?
  status       VehicleStatus @default(OFFLINE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  telemetryReadings          TelemetryReading[]
  alerts                     Alert[]
  maintenanceRecommendations MaintenanceRecommendation[]
}

model TelemetryReading {
  id                BigInt   @id @default(autoincrement())
  vehicleId         String
  recordedAt        DateTime @default(now())
  speedKmh          Float
  rpm               Int
  temperatureC      Float
  batteryVoltage    Float
  batteryPercentage Float
  currentAmps       Float
  vibration         Float
  latitude          Float?
  longitude         Float?
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@index([recordedAt])
}

enum AlertType {
  HIGH_TEMPERATURE
  LOW_BATTERY_VOLTAGE
  LOW_BATTERY_PERCENTAGE
  EXCESSIVE_VIBRATION
  TELEMETRY_MISSING
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id             String        @id @default(uuid())
  vehicleId      String
  type           AlertType
  severity       AlertSeverity
  status         AlertStatus   @default(ACTIVE)
  message        String
  triggeredAt    DateTime      @default(now())
  lastObservedAt DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, status])
  @@index([status, severity])
  @@index([triggeredAt])
}

enum MaintenanceType {
  COOLING_SYSTEM
  BATTERY_SYSTEM
  VIBRATION_INSPECTION
  TELEMETRY_SYSTEM
  GENERAL_INSPECTION
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model MaintenanceRecommendation {
  id          String              @id @default(uuid())
  vehicleId   String
  type        MaintenanceType
  priority    MaintenancePriority
  status      MaintenanceStatus   @default(OPEN)
  title       String
  description String
  reason      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completedAt DateTime?
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, status])
  @@index([priority, status])
  @@index([createdAt])
}
